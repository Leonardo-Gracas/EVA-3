# Opcional: troca o servidor de salas. Sem isso, "npm run dev" usa ws://localhost:8787
# e o build usa wss://eva3-salas.leo-gracas.workers.dev.
VITE_SERVER_URL=wss://eva3-salas.leo-gracas.workers.dev

# Opcional: ID de cliente OAuth do Google para o mestre conectar a conta do YouTube
# na trilha sonora (veja "Trilha sonora" no README). Sem isso, o player funciona com
# links e playlists do sistema, só não lista as playlists da conta.
VITE_GOOGLE_CLIENT_ID=
